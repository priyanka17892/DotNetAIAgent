## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Bb]in/
[Oo]bj/
out/
artifacts/
publish/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# NuGet
*.nupkg
packages/
.nuget/

# Dotnet tool manifests
dotnet-tools.json

# Publish / packaging
*.publishsettings
*.pubxml

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml
coverage/

# Database files
*.mdf
*.ldf
*.db
*.db-journal
*.dbmdl

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Rider caches
.idea/
*.sln.iml

# Local settings (Azure Functions, user secrets, etc.)
local.settings.json
secrets.json
secrets.*.json

# Logs
*.log

# OS generated
.DS_Store
Thumbs.db

# Packaging
*.vsix

# Ignore compiled binaries (optional)
*.exe
*.dll
*.pdb

# JetBrains Rider caches (redundant, safe)
.idea/

# End of .gitignore
